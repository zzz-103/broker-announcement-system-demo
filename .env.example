ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Comma-separated if multiple local frontend origins are needed.
FRONTEND_ORIGIN=http://localhost:5000,http://<HOST_IP>:5000

# Optional overrides. Defaults are resolved from the project root with pathlib.
SCRAPER_PYTHON_EXECUTABLE=/usr/local/bin/python
SCRAPER_SCRIPT_PATH=/app/backend/python-http-www-cfcpn-com-jcw/cfcpn_scraper.py
SCRAPER_WORKING_DIR=/app/backend/python-http-www-cfcpn-com-jcw
SCRAPER_LOOKBACK_DAYS=20

LLM_PYTHON_EXECUTABLE=/usr/local/bin/python
LLM_SCRIPT_PATH=/app/backend/llm_table/llm_markdown_table_builder.py
LLM_WORKING_DIR=/app/backend/llm_table
LLM_INPUT_DIR=/app/backend/python-http-www-cfcpn-com-jcw/output/notices
LLM_EXTERNAL_INPUT_DIR=/app/backend/python-http-www-cfcpn-com-jcw/output/external/notices
LLM_OUTPUT_DIR=/app/backend/data/staging
LLM_CONFIG_PATH=/app/backend/config/llm_api_config.json
LLM_WORKERS=4

ANNOUNCEMENT_STAGING_CSV_PATH=/app/backend/data/staging/announcement_table.csv
ANNOUNCEMENT_CSV_PATH=/app/backend/data/announcement_table.csv
USER_DB_PATH=/app/backend/data/users.db
USER_QUALIFICATION_CSV_PATH=/app/backend/config/user_qualification.csv
USER_QUALIFICATION_EMAIL_DOMAIN=csco.com.cn
PUBLISH_MIN_RETAIN_RATIO=0.5
AI_ANALYSIS_CACHE_PATH=/app/backend/data/ai-analysis.json
AI_ANALYSIS_WINDOW_DAYS=30
AI_ANALYSIS_TIMEOUT_SECONDS=120

# Pipeline analysis stage (called directly from the pipeline, no HTTP)
PIPELINE_ANALYSIS_ENABLED=true
PIPELINE_ANALYSIS_DAYS=30

# Independent scheduler process (python -m backend.api.scheduler)
# Set SCHEDULER_TOKEN to the same value in both the API and the scheduler.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_CRON=0 12 * * sun
SCHEDULER_API_URL=http://localhost:8000
SCHEDULER_TOKEN=change-me
