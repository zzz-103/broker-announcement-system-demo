ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_LIMIT=1000
JOB_HISTORY_LIMIT=100
# Comma-separated if multiple local frontend origins are needed.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://<HOST_IP>:5000
FRONTEND_DIST_PATH=frontend/out

# Optional overrides. Defaults are resolved from the project root with pathlib.
SCRAPER_PYTHON_EXECUTABLE=
SCRAPER_SCRIPT_PATH=
SCRAPER_WORKING_DIR=
SCRAPER_LOOKBACK_DAYS=20
OFFICIAL_SOURCE_SINCE_DATE=2026-04-01
OFFICIAL_SOURCE_DATA_DIR=backend/data/official-sources
CFCPN_PROCUREMENT_INPUT_DIR=backend/python-http-www-cfcpn-com-jcw/output/notices
CFCPN_RESULT_INPUT_DIR=backend/python-http-www-cfcpn-com-jcw/output/result/notices
SELECTED_SOURCE_OUTPUT_DIR=backend/python-http-www-cfcpn-com-jcw/output/selected

LLM_PYTHON_EXECUTABLE=
LLM_SCRIPT_PATH=
LLM_WORKING_DIR=
LLM_INPUT_DIR=backend/python-http-www-cfcpn-com-jcw/output/selected/procurement/notices
LLM_RESULT_INPUT_DIR=backend/python-http-www-cfcpn-com-jcw/output/selected/result/notices
LLM_EXTERNAL_INPUT_DIR=backend/python-http-www-cfcpn-com-jcw/output/external/notices
LLM_EXTERNAL_STATE_PATH=backend/data/staging/external-processed-sha256.json
LLM_OUTPUT_DIR=backend/data/staging
LLM_RESULT_OUTPUT_DIR=backend/data/staging/result
LLM_CONFIG_PATH=backend/config/llm_api_config.json
LLM_WORKERS=4

# Broker App update watcher. Runs from backend.broker_app_watch in the shared backend environment.
# APP_WATCH_PYTHON_EXECUTABLE defaults to the interpreter running FastAPI.
APP_WATCH_PYTHON_EXECUTABLE=
APP_WATCH_WORKING_DIR=.
APP_RELEASES_CSV_PATH=backend/data/broker_app_watch/exports/app_releases.csv
# Reuses the shared LLM config; falls back to LLM_CONFIG_PATH when unset.
APP_WATCH_LLM_CONFIG_PATH=backend/config/llm_api_config.json
# Pazq uses local OCR runtime; disable it where onnxruntime DLLs are unavailable.
BAW_DISABLED_BROKERS=pazq
BAW_ENVIRONMENT=development
BAW_REQUEST_TIMEOUT_SECONDS=20
# Optional App Watch schedule in the existing scheduler process; disabled preserves current behavior.
APP_WATCH_SCHEDULER_ENABLED=false
APP_WATCH_SCHEDULER_CRON=30 12 * * sun

# Dual-notice Pipeline matching outputs. The full pipeline validates and publishes the merged result automatically.
MATCHING_OUTPUT_DIR=backend/data/staging/matching
MATCHING_MAX_CANDIDATES=5
LLM_MATCHING_OUTPUT_DIR=backend/data/staging/llm_matching
IMPORTED_MATCHING_BASELINE_PATH=backend/data/staging/imported_matching_baseline.json
LLM_MATCHING_WORKERS=4
# Matching only returns a small JSON decision; keep the response budget bounded.
LLM_MATCHING_MAX_TOKENS=2048
# Per-request timeout; the existing SDK retry behavior remains unchanged.
LLM_MATCHING_TIMEOUT_SECONDS=180
MATCHING_MERGED_OUTPUT_DIR=backend/data/staging/final

ANNOUNCEMENT_CSV_PATH=backend/data/announcement_table.csv
ANNOUNCEMENT_BACKUP_RETENTION=3
# Optional persistent supplemental seed directory. On Windows deployments use runtime/data/supplemental.
SUPPLEMENTAL_DATA_DIR=backend/data/supplemental
USER_DB_PATH=backend/data/users.db
AUDIT_DB_PATH=backend/data/audit.db
USER_QUALIFICATION_CSV_PATH=backend/config/user_qualification.csv
USER_QUALIFICATION_EMAIL_DOMAIN=csco.com.cn
PUBLISH_MIN_RETAIN_RATIO=0.5
AI_ANALYSIS_CACHE_PATH=backend/data/ai-analysis.json
AI_ANALYSIS_WINDOW_DAYS=30
AI_ANALYSIS_TIMEOUT_SECONDS=120

# AI 自定义情报中心（密钥仅配置在后端环境，不要使用 NEXT_PUBLIC_ 前缀）
# 默认复用 USER_DB_PATH；仅在确有部署隔离需求时覆盖。
CUSTOM_INTELLIGENCE_DB_PATH=
CUSTOM_INTELLIGENCE_MAX_WORKERS=2
BAIDU_QIANFAN_API_KEY=
# 搜索接口固定使用百度 ai_search/web_search；Endpoint 不由浏览器或数据库覆盖。
BAIDU_QIANFAN_TIMEOUT_SECONDS=120
# DeepSeek 管理员覆盖文件位于 backend/data，且应保持在版本控制之外。
LLM_CONFIG_OVERRIDE_PATH=backend/data/llm_api_config.override.json
# 服务端环境仅作为管理员数据库尚未配置时的回退；管理页保存后以数据库为准。
# 推荐在“管理控制台 → 情报技术配置”填写并测试，授权码不要写入受版本控制的文件。
CUSTOM_INTELLIGENCE_EMAIL_ENABLED=false
SMTP_HOST=smtp.csco.com.cn
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_FROM_ADDRESS=
SMTP_AUTHORIZATION_CODE=
SMTP_TIMEOUT_SECONDS=30

# Standardized Manifest + five-dataset package used by both Export and Import.
# A matching_baseline.json is added only when the Manifest declares it available.
# The directory also persists the selected live/imported source state. In
# production it is covered by the runtime/data volume; keep it separate from
# users.db, audit.db, custom-intelligence/mail data and all secret configs.
# The API resolves the source (live by default, imported after a successful
# import) instead of treating this directory as a static frontend directory.
DASHBOARD_DATA_EXPORT_DIR=backend/data/dashboard-data
DASHBOARD_DATA_IMPORTED_ZIP_PATH=backend/data/dashboard-data/imported-dashboard-data.zip
DASHBOARD_DATA_WORKING_ZIP_PATH=backend/data/dashboard-data/current-dashboard-data.zip
DASHBOARD_DATA_SOURCE_PREFERENCE_PATH=backend/data/dashboard-data/source-preference.json

# Pipeline analysis stage (called directly from the pipeline, no HTTP)
PIPELINE_ANALYSIS_ENABLED=true
PIPELINE_ANALYSIS_DAYS=30

# Independent scheduler process (python -m backend.api.scheduler)
# Set SCHEDULER_TOKEN to the same value in both the API and the scheduler.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_CRON=0 12 * * sun
SCHEDULER_API_URL=http://127.0.0.1:8000
SCHEDULER_TOKEN=change-me

# Windows deployment gateway health base URL (read by deploy-release.ps1).
BROKER_VERSION=1.7.1
BROKER_PUBLIC_URL=http://localhost:8080
